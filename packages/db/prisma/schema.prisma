// Verro platform data model.
// Direct translation of Section 1 (Domain model) and Section 1.1 (network
// consent model) of platform-architecture-and-brd-additions.md.
//
// Key design points, carried over from that doc:
//  - Individuals (Broker) and businesses (BrokerBusiness) are modelled
//    separately. A broker business can be a sole trader (one Broker, one
//    BrokerBusinessMembership row) or a complex entity with many brokers
//    (multiple membership rows). ACL/credit representative info belongs to
//    the business, not the individual, except where an individual also
//    personally holds their own CRN.
//  - VerificationCheck, Document, ComplianceNote and ComplianceFlag can
//    each be about an individual broker OR a broker business (sometimes
//    both matter, e.g. a licence issue is business-level, a police check
//    is individual-level). Each of these models has a nullable brokerId
//    and a nullable brokerBusinessId - application code must enforce that
//    at least one is set, and ideally so should a DB-level CHECK
//    constraint added via a follow-up custom migration (Prisma's schema
//    language doesn't support arbitrary CHECK constraints directly).
//  - VerificationCheck.expiresAt implements the resolved decision that
//    check currency is a single global policy: every check type expires
//    12 months after it was run, platform-wide (not configurable per
//    organization).
//  - Verification (IDV/screening/doc-review/admin approval) is a ONE-TIME
//    pipeline that runs on Broker.overallStatus (BrokerVerificationStatus,
//    audited via BrokerStatusEvent) - not repeated per organization. Only
//    once that reaches ACTIVE can a BrokerRelationship be created at all
//    (enforced in OnboardingService.addRelationship). BrokerRelationship
//    (individual-to-org) and BrokerBusinessRelationship (business-to-org)
//    then carry their own much thinner RelationshipStatus - a single
//    lightweight accept step per organization, plus
//    FLAGGED/SUSPENDED/REVOKED for an org's own decision to cut a broker
//    off from just their organization. BrokerRelationship optionally
//    records which business the individual was operating under when the
//    relationship was formed.
//  - AccessGrant is the broker-controlled consent mechanism (Section 1.1 /
//    "Data sharing & consent" epic). Resolved decision: revocation is
//    never blocked, even while an organization holds an ACTIVE
//    relationship with that broker - the broker retains full control at
//    all times. (This can leave an org with an active accreditation but
//    no visibility into current compliance status - that's accepted as
//    intentional, not a bug.)
//  - ComplianceFlag is always visible to every organization holding a
//    GRANTED AccessGrant for the relevant broker/business (same broadcast
//    mechanism as an adverse VerificationCheck result) - that's the point
//    of a flag. ComplianceNote defaults to private to the authoring
//    organization and must be explicitly marked NETWORK_VISIBLE to share.
//  - StatusEvent, VerificationCheck, StatusEvent etc. are treated as
//    append-only audit trails.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  AGGREGATOR
  LENDER
  ASSOCIATION
  INTERNAL
}

// The broker's ONE global verification pipeline (Section 2, reworked):
// identity, screening, and document review happen once per broker, not
// once per organization relationship - this is the "verify once, trusted
// by the network" thesis actually enforced in the state machine, not just
// the data model. Broker.overallStatus is the real source of truth here
// (see the Broker model), driven by BrokerStatusEvent.
enum BrokerVerificationStatus {
  DRAFT
  SUBMITTED
  IDV_PENDING
  SCREENING_PENDING
  DOC_REVIEW_PENDING
  PENDING_ADMIN_APPROVAL
  ACTIVE
  DECLINED
  SUSPENDED
  REVOKED
}

// Per-organization relationship status - deliberately thin. A broker only
// reaches PENDING_ACCEPTANCE once their BrokerVerificationStatus is
// already ACTIVE (enforced in OnboardingService.addRelationship), so
// there's no IDV/screening/doc-review here to duplicate - the org just
// does one lightweight accept. FLAGGED/SUSPENDED/REVOKED stay
// per-relationship since an individual org can still cut a broker off
// from just their organization without touching the broker's status
// anywhere else. Shared by BrokerRelationship and
// BrokerBusinessRelationship.
//
// CREDIT_REP_PENDING and ACCREDITATION_PENDING (checklist rework) are
// type-specific intermediate stages, same pattern as BrokerVerificationStatus
// having stages that only make sense for one kind of row:
//   CREDIT_REP_PENDING - AGGREGATOR relationships only. The aggregator has
//     approved the broker but hasn't yet appointed them as a credit
//     representative / registered them with ASIC - see
//     BrokerRelationship.creditRepNumber. ACTIVE is blocked until that's
//     recorded (ComplianceService.transition).
//   ACCREDITATION_PENDING - LENDER relationships only. The lender has
//     accepted the relationship but the broker hasn't completed all
//     required TrainingRecord items yet (responsible lending, BID, privacy/
//     AML-CTF, CRM, product/policy training). ACTIVE is blocked until every
//     TrainingRecord for the relationship is completed.
enum RelationshipStatus {
  INVITED
  PENDING_ACCEPTANCE
  CREDIT_REP_PENDING
  ACCREDITATION_PENDING
  ACTIVE
  DECLINED
  FLAGGED
  SUSPENDED
  REVOKED
}

enum CheckType {
  IDV
  AML
  CREDIT
  POLICE
  ASIC
  ABN
}

enum CheckResult {
  PENDING
  PASS
  FAIL
  REVIEW_REQUIRED
}

enum DocReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccessGrantOrigin {
  BROKER_INITIATED
  ORG_REQUESTED
}

enum AccessGrantStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

enum PortalRole {
  BROKER
  CLIENT_STAFF
  CLIENT_ADMIN
  INTERNAL_ADMIN
  INTERNAL_REVIEWER
}

// --- Broker business structure ---

enum BusinessEntityType {
  SOLE_TRADER
  COMPANY
  PARTNERSHIP
  TRUST
}

// Whether the business holds its own Australian Credit Licence, or
// operates as a Credit Representative under someone else's licence
// (usually the aggregator's).
enum AclHolderType {
  OWN_ACL
  CREDIT_REPRESENTATIVE
}

enum BrokerBusinessMemberRole {
  PRINCIPAL
  DIRECTOR
  CREDIT_REPRESENTATIVE
  EMPLOYEE
  OTHER
}

// --- Compliance notes & flags ---

enum NoteVisibility {
  PRIVATE_TO_ORG
  NETWORK_VISIBLE
}

enum FlagCategory {
  CONDUCT
  FRAUD
  DOCUMENTATION
  LICENCE
  COMPLAINT
  OTHER
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FlagStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Broker {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  otherNames  String?
  dateOfBirth DateTime
  gender      String?
  email       String   @unique
  phone       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  state        String?

  // An individual can personally hold their own Credit Representative
  // Number in addition to (or instead of) operating under a business's
  // ACL/CR status - see BrokerBusiness for the business-level ACL/CRN.
  personalCrn String?

  // Epic: Broker onboarding - association link (self-declared; MFAA/FBAA
  // have no verification API today, see Section 5 of the arch doc, so
  // this stays a plain declared field until/unless that changes).
  associationName             String?
  associationMembershipNumber String?

  // Checklist rework - qualifications, licensing structure, and PI
  // insurance, captured as self-declared record-keeping fields during
  // onboarding (evidence itself is uploaded as a Document with a matching
  // docType, e.g. "CERT_IV"/"DIPLOMA"/"PI_INSURANCE" - see Document).
  // These don't gate the verification pipeline themselves (DOC_REVIEW_PENDING
  // already covers document review generically); they exist so the record
  // is visible on the broker's profile and to Admin/aggregators/lenders.
  certIvCompletedAt   DateTime?
  diplomaCompletedAt  DateTime?
  cpdHoursCurrentYear Int?

  piInsurancePolicyNumber String?
  piInsuranceExpiryAt     DateTime?

  // Epic: Broker onboarding - attestation to privacy policy / T&Cs prior
  // to onboarding. Null until accepted; submitOnboarding() requires this
  // to be set before the broker's verification pipeline can be submitted.
  attestedAt DateTime?

  // Real source of truth for the broker's ONE global verification
  // pipeline (Section 2, reworked) - driven by BrokerStatusEvent, not a
  // display rollup. A broker must reach ACTIVE here before they can
  // connect with any organization (see OnboardingService.addRelationship).
  overallStatus BrokerVerificationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessMemberships BrokerBusinessMembership[]
  relationships        BrokerRelationship[]
  documents            Document[]
  verificationChecks   VerificationCheck[]
  accessGrants         AccessGrant[]
  complianceNotes      ComplianceNote[]
  complianceFlags      ComplianceFlag[]
  statusEvents         BrokerStatusEvent[]
  // Login identity for this broker (Milestone 2 auth) - back-relation for
  // PortalUser.brokerId. Nullable because a Broker row can be created via
  // /brokers before/without a login existing yet in edge cases (e.g.
  // future org-initiated invites), though the self-serve signup flow
  // creates both together.
  portalUser           PortalUser?

  @@index([lastName, firstName])
}

// A broking business: could be a sole trader (one Broker, one membership
// row) or a company/partnership/trust with many brokers working under it.
model BrokerBusiness {
  id         String             @id @default(uuid())
  legalName  String
  tradingName String?
  entityType BusinessEntityType
  abnAcn     String?
  website    String?

  aclHolderType          AclHolderType
  aclNumber              String? // set when aclHolderType = OWN_ACL
  creditRepresentativeNumber String? // set when aclHolderType = CREDIT_REPRESENTATIVE
  // If operating as a Credit Representative, whose ACL is it under -
  // usually the aggregator's. Nullable because it isn't known/relevant
  // when aclHolderType = OWN_ACL.
  aclHolderOrganizationId String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  state        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aclHolderOrganization Organization? @relation("AclCreditRepresentatives", fields: [aclHolderOrganizationId], references: [id])

  memberships        BrokerBusinessMembership[]
  relationships       BrokerBusinessRelationship[]
  brokerRelationships BrokerRelationship[] // individual relationships formed under this business
  documents           Document[]
  verificationChecks  VerificationCheck[]
  complianceNotes     ComplianceNote[]
  complianceFlags     ComplianceFlag[]

  @@index([abnAcn])
}

// Join table: which brokers work at which broker business. Multiple rows
// per broker support moving between businesses over time (history is kept
// via startDate/endDate rather than being overwritten) - this is also
// what the "Transfer Requests" workflow in the source docs becomes once
// digitised (Section 1.1 / Section 6, broker portability).
model BrokerBusinessMembership {
  id               String                   @id @default(uuid())
  brokerId         String
  brokerBusinessId String
  role             BrokerBusinessMemberRole
  isPrimary        Boolean                  @default(true)
  startDate        DateTime                 @default(now())
  endDate          DateTime?

  createdAt DateTime @default(now())

  broker         Broker         @relation(fields: [brokerId], references: [id])
  brokerBusiness BrokerBusiness @relation(fields: [brokerBusinessId], references: [id])

  @@index([brokerId])
  @@index([brokerBusinessId])
}

// Business-level accreditation with an organization (typically the
// aggregation agreement between a broking business and an aggregator).
// Mirrors BrokerRelationship's shape and thin per-org status set (Section
// 2) but at the business level rather than the individual level. There's
// no separate business-level verification pipeline built yet (out of
// scope for this pass) - this still defaults to PENDING_ACCEPTANCE for
// consistency, but nothing currently gates it the way
// OnboardingService.addRelationship gates individual relationships.
model BrokerBusinessRelationship {
  id               String             @id @default(uuid())
  brokerBusinessId String
  organizationId   String
  status           RelationshipStatus @default(PENDING_ACCEPTANCE)
  accreditedDate   DateTime?
  nextReviewDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brokerBusiness BrokerBusiness @relation(fields: [brokerBusinessId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])

  statusEvents StatusEvent[]

  @@unique([brokerBusinessId, organizationId])
  @@index([organizationId, status])
}

model Organization {
  id          String  @id @default(uuid())
  orgType     OrgType
  legalName   String
  tradingName String?
  abnAcn      String?

  primaryContactEmail String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  postcode            String?
  state               String?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationships         BrokerRelationship[]
  businessRelationships BrokerBusinessRelationship[]
  portalUsers           PortalUser[]
  accessGrants          AccessGrant[]
  // Broker businesses operating as this org's Credit Representative
  // (aclHolderType = CREDIT_REPRESENTATIVE, aclHolderOrganizationId = this org).
  aclCreditRepresentatives BrokerBusiness[] @relation("AclCreditRepresentatives")
  complianceNotesAuthored ComplianceNote[]
  complianceFlagsRaised   ComplianceFlag[]
  // Which lenders this org (as an aggregator) has a panel agreement with,
  // and/or which aggregators this org (as a lender) accepts brokers
  // through - see AggregatorLenderPanel.
  panelsAsAggregator AggregatorLenderPanel[] @relation("PanelAsAggregator")
  panelsAsLender     AggregatorLenderPanel[] @relation("PanelAsLender")

  @@index([orgType])
}

// Which lenders a given aggregator has a panel agreement with - a broker
// can only connect to a lender that's on their current aggregator's
// panel (Section 2, chain-of-trust rework: association accepts first,
// then the aggregator, then only panel lenders become selectable).
model AggregatorLenderPanel {
  id              String @id @default(uuid())
  aggregatorOrgId String
  lenderOrgId     String

  createdAt DateTime @default(now())

  aggregatorOrg Organization @relation("PanelAsAggregator", fields: [aggregatorOrgId], references: [id])
  lenderOrg     Organization @relation("PanelAsLender", fields: [lenderOrgId], references: [id])

  @@unique([aggregatorOrgId, lenderOrgId])
  @@index([aggregatorOrgId])
  @@index([lenderOrgId])
}

// Individual-level relationship with an organization (matches the BRD's
// broker-centric onboarding flow: broker selects an aggregator/lender/
// association directly). Only created once the broker's own
// BrokerVerificationStatus is ACTIVE (Section 2, reworked) - so this
// starts at PENDING_ACCEPTANCE, a single lightweight accept step, rather
// than repeating IDV/screening/doc-review per organization.
//
// Chain-of-trust ordering (Section 2, further reworked): association and
// aggregator are independent of each other - a broker can connect to
// either first, in any order. A lender connection always requires an
// ACTIVE aggregator relationship first (exclusive - connecting to a new
// aggregator auto-revokes the old one), restricted to that aggregator's
// AggregatorLenderPanel. An ACTIVE association is not required for a
// lender connection - most lenders expect one in practice, but it isn't
// enforced. Losing the aggregator relationship (broker switches, or the
// aggregator revokes them) cascades to REVOKE every dependent lender
// relationship, since the lender only ever saw the broker through that
// aggregator's sponsorship - see OnboardingService.addRelationship and
// ComplianceService's cascade logic. Optionally records which broker
// business the individual was operating under when the relationship was
// formed/is currently active, since that context matters for compliance
// history even as the individual moves between businesses over time.
//
// Checklist rework: reaching ACTIVE now means something type-specific -
// see ComplianceService.transition. AGGREGATOR relationships require
// creditRepNumber to be set first (the aggregator's ACL appointment /ASIC
// registration, tracked here since it's specific to that aggregator
// relationship - a broker can hold a different CR number with a new
// aggregator after switching). LENDER relationships require every
// TrainingRecord for the relationship to be completed first (responsible
// lending, best-interests-duty, privacy/AML-CTF, CRM, product/policy
// training - auto-seeded when the relationship is created, see
// OnboardingService.addRelationship).
model BrokerRelationship {
  id               String             @id @default(uuid())
  brokerId         String
  organizationId   String
  brokerBusinessId String?
  status           RelationshipStatus @default(PENDING_ACCEPTANCE)
  accreditedDate   DateTime?
  nextReviewDate   DateTime?

  // AGGREGATOR relationships only - see model doc comment above.
  creditRepNumber       String?
  creditRepAuthorisedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broker         Broker          @relation(fields: [brokerId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  brokerBusiness BrokerBusiness? @relation(fields: [brokerBusinessId], references: [id])

  trainingRecords TrainingRecord[]
  statusEvents    StatusEvent[]

  @@unique([brokerId, organizationId])
  @@index([organizationId, status])
}

// Subject is EITHER a Broker OR a BrokerBusiness (exactly one of brokerId /
// brokerBusinessId should be set - enforced in application code, and
// ideally via a DB CHECK constraint added in a follow-up migration).
// ABN/ASIC/company-level checks are business-scoped; IDV/police/personal
// credit checks are broker-scoped.
model VerificationCheck {
  id               String      @id @default(uuid())
  brokerId         String?
  brokerBusinessId String?
  checkType        CheckType
  vendor           String?
  result           CheckResult @default(PENDING)
  rawResponse      Json?
  runAt            DateTime    @default(now())
  // Resolved decision (Open decision #4): a single global expiry policy,
  // not configurable per organization. Every check is valid for 12 months
  // from runAt; set at write time as runAt + 1 year.
  expiresAt        DateTime

  broker         Broker?         @relation(fields: [brokerId], references: [id])
  brokerBusiness BrokerBusiness? @relation(fields: [brokerBusinessId], references: [id])
  documents      Document[]

  @@index([brokerId, checkType])
  @@index([brokerBusinessId, checkType])
  @@index([expiresAt])
}

// Subject is EITHER a Broker OR a BrokerBusiness - same convention as
// VerificationCheck (e.g. a PI insurance certificate is business-level, a
// police certificate is individual-level).
model Document {
  id                  String          @id @default(uuid())
  brokerId            String?
  brokerBusinessId    String?
  docType             String
  storageKey          String
  reviewStatus        DocReviewStatus @default(PENDING)
  verificationCheckId String?
  uploadedAt          DateTime        @default(now())

  broker            Broker?             @relation(fields: [brokerId], references: [id])
  brokerBusiness    BrokerBusiness?     @relation(fields: [brokerBusinessId], references: [id])
  verificationCheck VerificationCheck?  @relation(fields: [verificationCheckId], references: [id])

  @@index([brokerId, docType])
  @@index([brokerBusinessId, docType])
}

model TrainingRecord {
  id             String    @id @default(uuid())
  relationshipId String
  trainingName   String
  completed      Boolean   @default(false)
  completedDate  DateTime?
  markedByUserId String?
  expiryDate     DateTime?

  createdAt DateTime @default(now())

  relationship BrokerRelationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId])
}

// Append-only audit trail for every status transition, at either the
// individual or business relationship level (exactly one of
// relationshipId / businessRelationshipId set). This is what a compliance
// auditor or a lender's risk team will eventually ask to see.
model StatusEvent {
  id                     String              @id @default(uuid())
  relationshipId         String?
  businessRelationshipId String?
  fromStatus             RelationshipStatus?
  toStatus               RelationshipStatus
  actionedBy             String?
  reason                 String?

  createdAt DateTime @default(now())

  relationship         BrokerRelationship?         @relation(fields: [relationshipId], references: [id])
  businessRelationship BrokerBusinessRelationship? @relation(fields: [businessRelationshipId], references: [id])
  actionedByUser        PortalUser?                @relation(fields: [actionedBy], references: [id])

  @@index([relationshipId, createdAt])
  @@index([businessRelationshipId, createdAt])
}

// Append-only audit trail for the broker's ONE global verification
// pipeline (Section 2, reworked) - separate from StatusEvent because it's
// typed to BrokerVerificationStatus rather than RelationshipStatus
// (Prisma enums can't be shared/unioned across fields). This is what
// Admin's broker verification queue is driven by and what a broker sees
// as their own progress on the profile page.
model BrokerStatusEvent {
  id          String                     @id @default(uuid())
  brokerId    String
  fromStatus  BrokerVerificationStatus?
  toStatus    BrokerVerificationStatus
  actionedBy  String?
  reason      String?

  createdAt DateTime @default(now())

  broker         Broker      @relation(fields: [brokerId], references: [id])
  actionedByUser PortalUser? @relation(fields: [actionedBy], references: [id])

  @@index([brokerId, createdAt])
}

// The single login identity across all three portals - a broker, a
// client organization's staff member, or internal Verro admin/reviewer
// all authenticate as a PortalUser, distinguished by `role` (and
// `organizationId` for client staff). Deliberately kept separate from
// Broker (which holds compliance-relevant PII/status, not credentials) so
// that non-broker roles - who have no Broker row at all - still fit the
// same table. For role = BROKER, brokerId links to the corresponding
// Broker profile; for every other role it stays null.
model PortalUser {
  id             String     @id @default(uuid())
  organizationId String?
  brokerId       String?    @unique
  role           PortalRole
  firstName      String?
  lastName       String?
  jobTitle       String?
  phone          String?
  email          String     @unique
  // Local auth for now (Milestone 2) - nullable so this table can later
  // carry Cognito-backed users (no local password) without a schema
  // change; login just checks whichever of passwordHash / external IdP
  // sub is populated.
  passwordHash   String?
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  broker          Broker?          @relation(fields: [brokerId], references: [id])
  statusEvents    StatusEvent[]
  brokerStatusEvents BrokerStatusEvent[]
  complianceNotes ComplianceNote[]
  complianceFlagsRaised   ComplianceFlag[] @relation("FlagRaisedBy")
  complianceFlagsResolved ComplianceFlag[] @relation("FlagResolvedBy")

  @@index([organizationId])
}

// Broker-controlled consent mechanism - Section 1.1 and the "Data sharing
// & consent" epic. Nothing about a broker is visible to an organization
// without a row here in status = GRANTED. Resolved decision: revoke is
// never blocked, even while the org holds an ACTIVE BrokerRelationship or
// BrokerBusinessRelationship - the broker retains full control at all
// times (see AccessGrantsService.revoke - intentionally has no blocking
// check).
model AccessGrant {
  id                String            @id @default(uuid())
  brokerId          String
  organizationId    String
  origin            AccessGrantOrigin
  status            AccessGrantStatus @default(PENDING)
  requestedByUserId String?
  decidedByBrokerId String?
  requestedAt       DateTime          @default(now())
  decidedAt         DateTime?

  broker       Broker       @relation(fields: [brokerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([brokerId, organizationId])
  @@index([organizationId, status])
}

// Free-text notes from FBAA/MFAA/lenders/aggregators against a broker or
// broker business. Defaults to private to the authoring organization;
// must be explicitly marked NETWORK_VISIBLE to be shared with other
// organizations holding a GRANTED AccessGrant. Subject is EITHER a Broker
// OR a BrokerBusiness (exactly one set).
model ComplianceNote {
  id               String         @id @default(uuid())
  brokerId         String?
  brokerBusinessId String?
  organizationId   String
  authorUserId     String
  body             String
  visibility       NoteVisibility @default(PRIVATE_TO_ORG)

  createdAt DateTime @default(now())

  broker         Broker?         @relation(fields: [brokerId], references: [id])
  brokerBusiness BrokerBusiness? @relation(fields: [brokerBusinessId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  authorUser     PortalUser      @relation(fields: [authorUserId], references: [id])

  @@index([brokerId])
  @@index([brokerBusinessId])
}

// Formal compliance flags raised by FBAA/MFAA/lenders/aggregators against
// a broker or broker business. Always visible to every organization
// holding a GRANTED AccessGrant for the relevant subject (same broadcast
// mechanism as an adverse VerificationCheck result, Section 1.1) - that's
// the entire point of a flag, unlike ComplianceNote which defaults
// private. Subject is EITHER a Broker OR a BrokerBusiness (exactly one set).
model ComplianceFlag {
  id                     String       @id @default(uuid())
  brokerId               String?
  brokerBusinessId       String?
  raisedByOrganizationId String
  raisedByUserId         String
  category               FlagCategory
  severity               FlagSeverity
  description            String
  status                 FlagStatus   @default(OPEN)
  resolvedAt             DateTime?
  resolvedByUserId       String?
  resolutionNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broker             Broker?         @relation(fields: [brokerId], references: [id])
  brokerBusiness     BrokerBusiness? @relation(fields: [brokerBusinessId], references: [id])
  raisedByOrganization Organization  @relation(fields: [raisedByOrganizationId], references: [id])
  raisedByUser       PortalUser      @relation("FlagRaisedBy", fields: [raisedByUserId], references: [id])
  resolvedByUser     PortalUser?     @relation("FlagResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([brokerId, status])
  @@index([brokerBusinessId, status])
}
