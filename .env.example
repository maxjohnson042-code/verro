# --- Database (local dev via docker-compose) ---
DATABASE_URL="postgresql://verro:verro@localhost:5432/verro?schema=public"

# --- Redis (BullMQ job queue - verification orchestration, Section 4) ---
REDIS_URL="redis://localhost:6379"

# --- AWS (Milestone 0: not provisioned by this scaffold - needs your AWS account) ---
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="verro-documents-dev"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# --- Auth (Milestone 2: local email+password + JWT sessions) ---
# Dev-only placeholder secret - generate a real random value before this
# ever runs anywhere but your own machine.
JWT_SECRET="verro-dev-secret-change-me"

# --- Auth (AWS Cognito) - future swap-in once you're ready for production
# infra; not wired up yet, see JWT_SECRET above for what's live today ---
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_REGION="ap-southeast-2"

# --- Email (transactional notifications via Resend - resend.com) ---
# Sign up free at https://resend.com, create an API key, and paste it below.
# Until you add real values, emails are logged to the API console instead of
# actually sending (see NotificationsService) - the app works fine either way.
RESEND_API_KEY=""
EMAIL_FROM="Verro <onboarding@resend.dev>"
# Base URL of the web app (apps/web) - used to build links inside emails,
# e.g. "log in to view your profile". Not the API's own URL.
APP_BASE_URL="http://localhost:3000"

# --- Vendor integrations (Milestones 2-3, leave blank until accounts exist) ---
ABR_ABN_LOOKUP_GUID=""
CREDIT_BUREAU_API_KEY=""

# --- ID&V via Sumsub (sumsub.com) - replaces the originally-planned
# FrankieOne integration. Sign up free, create an app token + secret key
# pair in Sandbox mode (Dashboard > Developers > App tokens), and a webhook
# pointed at POST {API}/verification/idv/webhook with a secret key set
# (Dashboard > Developers > Webhooks) for the applicantReviewed event.
# Until SUMSUB_APP_TOKEN/SUMSUB_SECRET_KEY are set, brokers get a clear
# error instead of a broken widget - there's no safe "PENDING" fallback for
# identity verification the way there is for email/ABN.
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
SUMSUB_WEBHOOK_SECRET=""
# "basic-kyc-level" is Sumsub's default level name available in every new
# Sandbox account - swap for your own configured level name once you have one.
SUMSUB_LEVEL_NAME="basic-kyc-level"

# --- App ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001
NODE_ENV=development
