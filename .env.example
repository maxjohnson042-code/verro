# --- Database (local dev via docker-compose) ---
DATABASE_URL="postgresql://verro:verro@localhost:5432/verro?schema=public"

# --- Redis (BullMQ job queue - verification orchestration, Section 4) ---
REDIS_URL="redis://localhost:6379"

# --- AWS (Milestone 0: not provisioned by this scaffold - needs your AWS account) ---
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="verro-documents-dev"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# --- Auth (AWS Cognito) - create a User Pool in ap-southeast-2 and fill these in ---
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_REGION="ap-southeast-2"

# --- Email (transactional notifications, e.g. SES) ---
SES_FROM_EMAIL="noreply@verro.example"

# --- Vendor integrations (Milestones 2-3, leave blank until accounts exist) ---
FRANKIE_ONE_API_KEY=""
FRANKIE_ONE_BASE_URL=""
ABR_ABN_LOOKUP_GUID=""
CREDIT_BUREAU_API_KEY=""

# --- App ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001
NODE_ENV=development
